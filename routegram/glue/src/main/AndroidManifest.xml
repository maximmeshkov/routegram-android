<?xml version="1.0" encoding="utf-8"?>
<!-- Объявляем ContentProvider как точку авто-инициализации.
     Manifest merger вольёт его в финальный APK любого app-варианта,
     который зависит от :routegram:glue — без правок ApplicationLoader.
     authority уникален per-app благодаря ${applicationId}. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.routegram.glue.RoutegramInitProvider"
            android:authorities="${applicationId}.routegram.init"
            android:exported="false" />
    </application>
</manifest>
